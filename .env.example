# Copy this file to ".env" and adjust if you want to override defaults.
# All values are optional.

# Where the SQLite database lives. On hosts that wipe local files, point this
# at a mounted persistent disk (see the deployment notes).
# ATTIC_DB=./data/attic.db

# Folder used for the database and the auto-generated secret key.
# ATTIC_DATA_DIR=./data

# Secret used to sign session cookies. If not set, Attic generates one and
# stores it in the data folder. On free hosts, set this to a fixed value.
# ATTIC_SECRET_KEY=change-me-to-a-long-random-string

# How long a login lasts, in hours. 720 = 30 days.
# ATTIC_SESSION_HOURS=720

# Set to true when the app is served over HTTPS so cookies are marked Secure.
# ATTIC_COOKIE_SECURE=false
